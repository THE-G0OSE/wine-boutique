{
  "name": "wine-boutique",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @wine/web dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "contracts:gen": "pnpm --filter @wine/contracts contracts:gen"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
