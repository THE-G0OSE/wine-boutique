{
  "name": "wine-boutique",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter @wine/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @wine/e2e e2e",
    "contracts:gen": "pnpm --filter @wine/contracts contracts:gen",
    "backend:up": "docker compose -f deploy/compose/compose.yaml up -d --build",
    "backend:up:observability": "cross-env OTEL_SDK_DISABLED=false TRAEFIK_TRACING=true docker compose -f deploy/compose/compose.yaml --profile observability up -d --build",
    "backend:down": "docker compose -f deploy/compose/compose.yaml --profile observability down",
    "backend:logs": "docker compose -f deploy/compose/compose.yaml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "16.5.0",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
