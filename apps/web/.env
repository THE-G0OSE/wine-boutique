# Несекретные значения по умолчанию. Локальные переопределения — в .env.local (не коммитится)
VITE_API_URL=/api
# Пока нет бэкенда, запросы обслуживает MSW (src/app/providers/mocks)
VITE_API_MOCKS=true
# Публичный дашборд Grafana (только просмотр) — ссылка «Мониторинг» в футере; пусто — ссылки нет
VITE_MONITORING_URL=https://thegoosedev.ru/grafana/public-dashboards/02fb9db7f53d40f486101d59b9d9e1fb
