# Окружение бэкенда на VPS: скопировать в /opt/wine-boutique/.env (вне репозитория), права 600.
# Пароли — длинные случайные: openssl rand -base64 32 | tr -d '/+='

# Домен сайта (A-запись на IP VPS): фронт и API на одном адресе, сертификат — на него.
# Без своего домена — sslip.io: 1-2-3-4.sslip.io указывает на 1.2.3.4
API_DOMAIN=example.ru
# Адрес фронта для проверки Origin и CORS: фронт с VPS — https://<API_DOMAIN>
FRONT_ORIGIN=https://example.ru
# Почта для Let's Encrypt — необязательна (писем об истечении сертификатов он больше не шлёт)
ACME_EMAIL=
# Для пробы без лимитов Let's Encrypt — тестовый центр: https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CA_SERVER=

# Суперпользователь Postgres и роли сервисов: у каждой своя
POSTGRES_PASSWORD=
CATALOG_DB_PASSWORD=
NEWS_DB_PASSWORD=
REVIEWS_DB_PASSWORD=
NEWSLETTER_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
RESERVATIONS_DB_PASSWORD=
TASTINGS_DB_PASSWORD=
CELLAR_DB_PASSWORD=
REQUESTS_DB_PASSWORD=
LOYALTY_DB_PASSWORD=

# Демо-данные из макетов (вина, газета, письма) — при первой выкатке true, потом false
SEED=true

# Наблюдаемость: deploy.sh с --observability включает Grafana-стек; трейсы и метрики сервисов
# OTEL_SDK_DISABLED=false
# TRAEFIK_TRACING=true
