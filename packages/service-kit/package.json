{
  "name": "@wine/service-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Общая техника сервисов: конфиг, логи, ошибки в формате контракта, валидация, health, запуск. Без бизнес-логики",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/terminus": "12.1.0",
    "@wine/contracts": "workspace:*",
    "fastify": "5.12.5",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@standard-schema/spec": "1.1.0",
    "@swc/core": "1.16.18",
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5",
    "@nestjs/testing": "12.1.3",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@nestjs/testing": "12.1.3",
    "yaml": "2.9.1"
  },
  "peerDependenciesMeta": {
    "@nestjs/testing": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  }
}
