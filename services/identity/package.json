{
  "name": "@wine/identity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Сервис identity: сессия посетителя (пока всегда гость), позже — вход по телефону",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps --import @opentelemetry/auto-instrumentations-node/register dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.2",
    "@wine/contracts": "workspace:*",
    "@wine/service-kit": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
