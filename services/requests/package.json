{
  "name": "@wine/requests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Сервис requests: заявки на зал и корпоративные подарки, набор месяца, подарочные сертификаты",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps --import @wine/service-kit/telemetry dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --enable-source-maps dist/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@wine/contracts": "workspace:*",
    "@wine/demo-data": "workspace:*",
    "@wine/service-kit": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^24.19.2",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
