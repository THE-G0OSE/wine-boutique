// База сервиса catalog: вина, полки магазина и сорта винограда (docs/backend-plan.md §3).
// Клиент генерируется внутрь сервиса — другие сервисы его не видят.

generator client {
  provider            = "prisma-client"
  output              = "../src/infrastructure/prisma/generated"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum WineCategory {
  red
  white
  sparkling
  sweet

  @@map("wine_category")
}

/// Полки магазина: red — красные, white — белые, sparkling — игристые и сладкие, aged — коллекция 10+ лет
enum WineShelf {
  red
  white
  sparkling
  aged

  @@map("wine_shelf")
}

/// Силуэт бутылки на полке — от него зависят картинка и высота
enum BottleShape {
  red
  white
  sweet
  sparkling
  burgundy
  flute
  black
  prosecco
  port
  tokaji

  @@map("bottle_shape")
}

enum GrapeType {
  red
  white

  @@map("grape_type")
}

model Wine {
  id             String             @id @default(uuid(7)) @db.Uuid
  slug           String             @unique
  name           String
  /// Полки, на которых стоит вино (может быть несколько)
  categories     WineCategory[]
  region         String
  country        String?
  /// Названия сортов для карточки, как в контракте
  grapes         String[]
  volumeMl       Int                @map("volume_ml")
  vintage        Int?
  /// С какого года бутылка в погребе бутика; в API — cellarYears
  cellaredAt     DateTime?          @map("cellared_at") @db.Date
  /// Цена в копейках; в API — рубли
  priceKopecks   Int?               @map("price_kopecks")
  imageUrl       String             @map("image_url")
  /// Порядок сортировки popular: меньше — выше
  popularityRank Int                @map("popularity_rank")
  /// Когда вино появилось в бутике — сортировка new
  arrivedAt      DateTime           @map("arrived_at") @db.Timestamptz
  bottle         BottleShape        @default(red)
  // Карточка вина (паспорт, вкус, подача): тексты — как на этикетке
  producer       String?
  appellation    String?
  abv            String             @default("")
  aging          String             @default("")
  potential      String             @default("")
  badges         String[]           @default([])
  /// { body, tannins, acidity, sweetness }, у каждой шкалы { level 1–5, word }; null — сомелье ещё не описал
  profile        Json?
  /// { aroma, taste, finish }
  notes          Json               @default("{}")
  /// [{ icon, text }] — с чем подавать
  food           Json               @default("[]")
  /// { temperature, decanting, glass }; null — подача не описана
  serve          Json?
  sommelierNote  String             @default("") @map("sommelier_note")
  /// Текст для поиска: название, сорта, регион, страна, винодельня, апелласьон — в нижнем регистре, «ё» → «е».
  /// Собирает приложение при записи; ищется подстрокой по триграммному индексу
  searchText     String             @default("") @map("search_text")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  varieties      GrapeVarietyWine[]
  shelves        ShelfWine[]
  related        WineRelation[]     @relation("related_from")
  relatedTo      WineRelation[]     @relation("related_to")

  @@index([categories], type: Gin)
  @@index([grapes], type: Gin)
  @@index([country])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "wines_search_text_trgm_idx")
  @@index([priceKopecks])
  @@index([vintage])
  @@index([arrivedAt])
  @@index([popularityRank])
  @@map("wines")
}

model GrapeVariety {
  id          String             @id @default(uuid(7)) @db.Uuid
  slug        String             @unique
  name        String
  type        GrapeType
  origin      String
  taste       String
  harvest     String
  description String
  plantation  String?
  imageUrl    String             @map("image_url")
  position    Int
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  wines       GrapeVarietyWine[]

  @@map("grape_varieties")
}

/// Вина сорта — до трёх, по порядку
model GrapeVarietyWine {
  varietyId String       @map("variety_id") @db.Uuid
  wineId    String       @map("wine_id") @db.Uuid
  position  Int
  variety   GrapeVariety @relation(fields: [varietyId], references: [id], onDelete: Cascade)
  wine      Wine         @relation(fields: [wineId], references: [id], onDelete: Cascade)

  @@id([varietyId, wineId])
  @@unique([varietyId, position])
  @@map("grape_variety_wines")
}

/// Полка магазина: название, подпись к табличке и вступление страницы полки
model Shelf {
  id          WineShelf   @id
  title       String
  note        String
  description String
  /// Порядок полок в магазине
  position    Int
  wines       ShelfWine[]

  @@map("shelves")
}

/// Бутылки на полке — в том порядке, как их расставил бутик (сортировка popular на полке)
model ShelfWine {
  shelfId  WineShelf @map("shelf_id")
  wineId   String    @map("wine_id") @db.Uuid
  position Int
  shelf    Shelf     @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  wine     Wine      @relation(fields: [wineId], references: [id], onDelete: Cascade)

  @@id([shelfId, wineId])
  @@unique([shelfId, position])
  @@index([wineId])
  @@map("shelf_wines")
}

/// «С этим вином берут» по выбору сомелье; если пусто — соседи по полке
model WineRelation {
  wineId    String @map("wine_id") @db.Uuid
  relatedId String @map("related_id") @db.Uuid
  position  Int
  wine      Wine   @relation("related_from", fields: [wineId], references: [id], onDelete: Cascade)
  related   Wine   @relation("related_to", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([wineId, relatedId])
  @@index([relatedId])
  @@map("wine_relations")
}
